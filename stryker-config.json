{
  "$schema": "https://stryker-mutator.io/schemas/stryker-config.schema.json",
  "_comment": "Stryker.NET Configuration for NEXTERP - Backend Mutation Testing",
  "stryker-config": {
    "project": "ERP.slnx",
    "test-projects": [
      "ERP.Domain.UnitTests/ERP.Domain.UnitTests.csproj",
      "ERP.Application.UnitTests/ERP.Application.UnitTests.csproj"
    ],
    "concurrency": 4,
    "coverage-analysis": "perTest",
    "mutate": [
      "!/**/*.cs",
      "!**/Program.cs",
      "!**/obj/**",
      "!**/bin/**",
      "!**/Migrations/**",
      "!**/*.Designer.cs",
      "!**/AutoGenerated/**"
    ],
    "excluded-mutations": [
      "string",
      "logical",
      "linq"
    ],
    "thresholds": {
      "high": 80,
      "low": 70,
      "break": 60
    },
    "reporters": [
      "html",
      "json",
      "cleartext"
    ],
    "htmlReporter": {
      "baseDir": "reports/stryker"
    },
    "jsonReporter": {
      "baseDir": "reports/stryker"
    },
    "dashboards": {
      "enabled": false,
      "project": "NEXTERP/Backend",
      "module": "ERP.Backend"
    },
    "outputPath": "reports/stryker"
  }
}

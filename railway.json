{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet restore ERP.API/ERP.API.csproj && dotnet build -c Release ERP.API/ERP.API.csproj",
    "startCommand": "dotnet run --project ERP.API/ERP.API.csproj -c Release --urls \"http://0.0.0.0:$PORT\""
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
